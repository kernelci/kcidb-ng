FROM python:3.13-bookworm

# Deprecated: this image builds the legacy ingester implementation (ingester/ingester.py).
# Prefer Dockerfile.django-ingester for production/active deployments.

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y ca-certificates git

RUN git clone https://github.com/kernelci/kcidb.git && \
    cd kcidb && \
    pip install -e . && \
    pip install prometheus_client 'certifi>=2026.10.19'

COPY ingester/ingester.py /app/ingester.py
COPY data/trees.yml /app/trees.yml

CMD ["python", "/app/ingester.py", "--spool-dir", "/app/spool"]
